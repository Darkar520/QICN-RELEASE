{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qicn-roadmap-v3-phase6-3e-raw-ofia-trace-schema",
  "title": "QICN Roadmap v3 Phase 6.3E raw OFIA unified trace schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "seed",
    "self_locus_trace",
    "perturbation_events",
    "information_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "self_locus_trace": {
      "type": "object",
      "description": "The same observable self-locus signal family consumed by extractSelfLocus. It must not contain true_self_locus_id, latent_truth, expected ownership, or cooked QICN variables.",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "trace_id",
        "seed",
        "windows"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "seed": {
          "type": "string"
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "true_self_locus_id"
            ]
          },
          {
            "required": [
              "latent_truth"
            ]
          },
          {
            "required": [
              "expected_ownership"
            ]
          },
          {
            "required": [
              "QICN_OFIA"
            ]
          }
        ]
      }
    },
    "perturbation_events": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "pair_id",
          "t",
          "perturbation_target_id",
          "target_impulse_amplitude",
          "downstream_observations"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "t": {
            "type": "number"
          },
          "perturbation_target_id": {
            "type": "string",
            "description": "Observable by design: the experimenter knows which locus was perturbed. This is not the latent self id."
          },
          "target_impulse_amplitude": {
            "type": "number",
            "minimum": 0
          },
          "downstream_observations": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "channel_id",
                "pre_value",
                "post_value",
                "response_delay",
                "recovery_fraction"
              ],
              "properties": {
                "channel_id": {
                  "type": "string"
                },
                "pre_value": {
                  "type": "number"
                },
                "post_value": {
                  "type": "number"
                },
                "response_delay": {
                  "type": "number",
                  "minimum": 0
                },
                "recovery_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "bookkeeping_label_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Optional distractor field; the extractor must not treat it as ownership truth."
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "true_self_locus_id"
              ]
            },
            {
              "required": [
                "is_self_target"
              ]
            },
            {
              "required": [
                "expected_ownership"
              ]
            },
            {
              "required": [
                "control_ownership"
              ]
            },
            {
              "required": [
                "precomputed_ofia"
              ]
            }
          ]
        }
      }
    },
    "information_boundary": {
      "type": "string",
      "const": "Extractor-visible input includes observable perturbation_target_id and downstream dynamics, but excludes true_self_locus_id, latent_truth, is_self_target labels, expected_ownership, control_ownership, cooked ownership scores, and precomputed QICN_OFIA."
    }
  }
}
